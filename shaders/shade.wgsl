// `sample_field(p)`, the field filtered at a shade-pixel position, is appended by the renderer
// in the form the device supports.
@group(0) @binding(3) var field: texture_2d<f32>;
@group(0) @binding(4) var smp: sampler;

fn blob(d: vec2f, amp: f32, c: vec2f, rot: vec2f, inv: vec2f) -> f32 {
    let q = d - c;
    let uv = vec2f(rot.x * q.x + rot.y * q.y, -rot.y * q.x + rot.x * q.y) * inv;
    return amp * exp(-0.5 * dot(uv, uv));
}

// BALL_FIT_BEGIN (generated by tools/ballshade.py from the cover)
fn ball_lum(d: vec2f) -> f32 {
    let x = d.x;
    let y = d.y;
    let r2 = dot(d, d);
    var l = 0.26601 + 0.08711 * x + 1.02816 * y + -0.76733 * x * x + -1.03938 * x * y + -1.03326 * y * y;
    l += blob(d, 1.37060, vec2f(-0.42683, -0.30344), vec2f(-0.13364, -0.99103), vec2f(8.08589, 7.19971));
    l += blob(d, 0.75140, vec2f(0.07977, -0.56292), vec2f(0.56340, 0.82618), vec2f(10.48490, 11.31159));
    l += blob(d, 0.75522, vec2f(-0.09243, -0.48432), vec2f(0.98415, 0.17735), vec2f(4.50412, 6.37963));
    l += blob(d, 0.26873, vec2f(-0.30114, -0.10608), vec2f(0.94722, -0.32059), vec2f(3.58835, 8.54353));
    l += blob(d, 1.50000, vec2f(0.47790, -0.51759), vec2f(0.99838, -0.05697), vec2f(5.26961, 3.12448));
    l += blob(d, -0.49857, vec2f(-1.30000, 0.24415), vec2f(0.96863, 0.24850), vec2f(0.95025, 8.71053));
    l += blob(d, 0.24118, vec2f(-0.83944, 0.14364), vec2f(0.75414, -0.65671), vec2f(31.89520, 8.73541));
    l += blob(d, 0.84292, vec2f(0.36901, -0.00423), vec2f(-0.12057, 0.99271), vec2f(3.92185, 5.42683));
    l += blob(d, 1.50000, vec2f(-0.05638, -0.82740), vec2f(0.93083, -0.36544), vec2f(1.48643, 5.72239));
    l += blob(d, -1.08774, vec2f(-0.03158, 1.30000), vec2f(0.98470, 0.17427), vec2f(11.09038, 2.50082));
    l += blob(d, -1.01770, vec2f(0.45885, -0.26582), vec2f(0.98167, 0.19061), vec2f(5.75105, 2.16318));
    l += blob(d, 1.19256, vec2f(-1.28058, 0.20985), vec2f(0.65688, -0.75399), vec2f(0.83333, 5.64468));
    let r = sqrt(r2) + 1e-6;
    l += 0.88195 * exp(3.26089 * (dot(d, vec2f(-0.72567, -0.68804)) / r - 1.0) - pow((1.0 - r) * 17.51046, 2.0));
    l += -0.75865 * exp(31.89122 * (dot(d, vec2f(0.32332, -0.94629)) / r - 1.0) - pow((1.0 - r) * 10.40776, 2.0));
    l += -1.00000 * exp(3.34633 * (dot(d, vec2f(-0.98815, 0.15347)) / r - 1.0) - pow((1.0 - r) * 10.98765, 2.0));
    let r8 = r2 * r2 * r2 * r2;
    l += (1.20274 + -0.27464 * x + -0.07018 * y) * r8 + (-0.79774 + 0.53489 * x + 0.00631 * y) * r8 * r8 * r8;
    return min(l, 0.955);
}
// BALL_FIT_END

const LIGHT = vec2f(-0.8716, -0.4903);   // toward the light, on screen
// toward the key light in camera space, as placed by the ball's main highlight
const LIGHT3 = vec3f(-0.734, -0.513, -0.445);
const GRAIN_PERIOD = 0.4;                      // grain refresh period for the moving liquid

// Grain of a fixed physical size (cell in ref px), about unit spread, two octaves. Zooming
// magnifies it; fpx (ref px per shaded px) fades out each octave before it nears two
// displayed pixels per cycle, where it would shimmer as it drifts. An octave that has faded
// out is not evaluated, which is most of the grain's cost once the picture is minified.
// Returns the grain in x and its slope per reference pixel in yz.
fn grain_slope(p: vec2f, cell: f32, fpx: f32) -> vec3f {
    let q = p / cell;
    let k = fpx * u.supersampling / cell;
    let fa = 1.0 - smoothstep(0.4, 0.625, k);
    let fb = 1.0 - smoothstep(0.4, 0.625, 2.13 * k);
    var n = vec3f(0.0);
    let stride = fpx / cell;
    if (fa > 0.0) { n = gradient_noise_spaced(q, stride) * vec3f(1.0, vec2f(1.0 / cell)) * fa; }
    if (fb > 0.0) { n += gradient_noise_spaced(q * 2.13 + 7.3, 2.13 * stride) * vec3f(1.0, vec2f(2.13 / cell)) * (0.55 * fb); }
    return n * 4.4;
}

fn grain(p: vec2f, cell: f32, fpx: f32) -> f32 {
    return grain_slope(p, cell, fpx).x;
}

// Grain carried by the liquid at screen velocity v: two copies drift with it and take turns,
// each restarting while hidden, so it never stretches far. Value and slope, as grain_slope.
fn flow_grain(gp: vec2f, v: vec2f, cell: f32, fpx: f32, seed: f32) -> vec3f {
    let ph = u.time / GRAIN_PERIOD;
    let f1 = fract(ph);
    let f2 = fract(ph + 0.5);
    let n1 = grain_slope(gp - v * (f1 * GRAIN_PERIOD) + hash22(vec2f(floor(ph), seed)) * 211.0, cell, fpx);
    let n2 = grain_slope(gp - v * (f2 * GRAIN_PERIOD) + hash22(vec2f(floor(ph + 0.5), seed + 3.0)) * 211.0, cell, fpx);
    let w = 1.0 - abs(2.0 * f1 - 1.0);
    return (w * n1 + (1.0 - w) * n2) * inverseSqrt(w * w + (1.0 - w) * (1.0 - w));
}

// Tone ramp of the lilac paint, sampled from the cover (0 darkest speckle, 1 hairline highlight).
fn lilac(t: f32) -> vec3f {
    let x = clamp(t, 0.0, 1.0) * 5.0;
    let i = min(i32(x), 4);
    var k = array<vec3f, 6>(
        vec3f(56.0, 40.0, 70.0), vec3f(100.0, 76.0, 118.0), vec3f(138.0, 106.0, 154.0),
        vec3f(168.0, 137.0, 182.0), vec3f(201.0, 171.0, 208.0), vec3f(240.0, 218.0, 242.0));
    return mix(k[i], k[i + 1], x - f32(i)) / 255.0;
}

// Mean over x from x0 to x1 of a ramp that rises from 0 at a to 1 at b.
fn ramp_mean(a: f32, b: f32, x0: f32, x1: f32) -> f32 {
    let u0 = clamp((x0 - a) / (b - a), 0.0, 1.0);
    let u1 = clamp((x1 - a) / (b - a), 0.0, 1.0);
    let area = 0.5 * (b - a) * (u1 * u1 - u0 * u0) + max(x1 - max(x0, b), 0.0);
    return area / max(x1 - x0, 1e-4);
}

// Cross-section of a band lit from one edge: tone and speckle density over the stretch of the
// band a pixel covers, from d0 to d1 from the lit edge and about ds from the shadowed one (ref
// px), for a band w wide. Thin bands are a pale stripe over a speckled body; fat ones are
// airbrushed tubes whose shadow side dissolves into speckle. The pale stripe is thinner than a
// pixel in a wide view, so it counts for the share of the stretch it fills.
fn band_profile(d0: f32, d1: f32, ds: f32, w: f32) -> vec2f {
    let dl = 0.5 * (d0 + d1);
    let fat = smoothstep(7.0, 18.0, w);
    let pw = 0.36 * w + 0.12 * max(w - 8.0, 0.0);
    var t = mix(0.92 + P(P_BAND_EDGE_TONE), 0.44 + P(P_BAND_BODY_TONE), ramp_mean(pw - 0.5, pw + 0.6 + 0.1 * w, d0, d1));
    var dens = 0.48 * ramp_mean(pw - 0.5, pw + 1.5 + 0.2 * w, d0, d1);
    let across = max(dl + ds, 1e-3);
    let uu = dl / across;
    let hu = 0.5 * (d1 - d0) / across;
    let tt = mix(0.9, 0.4, smoothstep(0.3 - hu, 0.88 + hu, uu)) - 0.12 * smoothstep(0.85 - hu, 1.0 + hu, uu);
    let td = 0.5 * smoothstep(0.5 - hu, 0.85 + hu, uu) + 0.3 * smoothstep(0.85 - hu, 1.0 + hu, uu);
    let ft = fat * (1.0 - P(P_FAT_BAND_FLATTEN));
    t = mix(t, tt, ft);
    dens = mix(dens, td, ft);
    t = mix(1.0, t, ramp_mean(0.25, 0.9 + 0.03 * w, d0, d1));
    return vec2f(t, dens);
}

// Coverage of one stripe band on the near side at c, with the cross-section shading.
struct Band {
    coverage: f32,
    tone: f32,
    density: f32,
}

// Length of the stretch from a to b that lies within h of f.
fn overlap(f: f32, h: f32, a: f32, b: f32) -> f32 {
    return max(min(f + h, b) - max(f - h, a), 0.0);
}

fn band_at(c: f32, glen: f32, gh: vec2f, m: f32, edge: f32, rough: f32) -> Band {
    var o: Band;
    let k = floor(c);
    let f = c - k;
    let duty = DUTY + (0.05 + P(P_BAND_WIDTH_JITTER)) * (value_noise(vec2f(m * 0.35, k * 3.7)) - 0.5) + 0.03 * (hash12(vec2f(k, 7.0)) - 0.5);
    let lo = 1.0 - duty;
    let w = duty / glen;
    // distances (ref px) to the band's low and high edges; negative outside the band
    let a_lo = (f - lo) / glen;
    let a_hi = select((1.0 - f) / glen, -f / glen, f < lo);
    // share of the pixel's width across the lines that this band and its two neighbours
    // cover, so a band thinner than the pixel weighs what it covers and no more
    let h = 0.5 * glen / edge;
    let r = rough * glen;
    o.coverage = clamp((overlap(f, h, lo - r, 1.0 + r) + overlap(f, h, lo - 1.0 - r, r) + overlap(f, h, lo + 1.0 - r, 2.0 + r)) / (2.0 * h), 0.0, 1.0);
    // the high edge faces +grad c; light it when that faces the light
    let e = clamp(dot(gh, LIGHT) / 0.35, -1.0, 1.0);
    // the stretch of the band under the pixel, as distances from each edge
    let reach = 0.5 / edge;
    let hi = clamp(vec2f(a_hi - reach, a_hi + reach), vec2f(0.0), vec2f(w));
    let low = clamp(vec2f(a_lo - reach, a_lo + reach), vec2f(0.0), vec2f(w));
    let lit_hi = band_profile(hi.x, hi.y, max(a_lo, 0.0), w);
    let lit_lo = band_profile(low.x, low.y, max(a_hi, 0.0), w);
    let pr = mix(lit_lo, lit_hi, 0.5 + 0.5 * e);
    o.tone = pr.x;
    o.density = pr.y;
    return o;
}

// Per-pixel values shared by every stage.
struct Pixel {
    pos: vec2f,            // output pixel position
    cover: vec2f,          // position on the cover
    out_px_per_cover: f32,
    out_px_per_ref: f32,
    ref_px_per_out: f32,
    edge: f32,             // edge ramps per reference pixel
    field_step: f32,       // field texel step, in output pixels
    line: f32,             // stripe line coordinate in periods, negative inside the stream
    flow_label: f32,       // label that rides with the fluid along each band
    line_grad_len: f32,    // length of the line coordinate gradient
    line_grad_dir: vec2f,  // direction of that gradient
    plane_rel: vec2f,      // plane position relative to the obstacle centre
    obstacle_dist: f32,    // distance from the obstacle centre, in obstacle radii
    obstacle_down: f32,    // downstream distance from the obstacle centre, in obstacle radii
    grain_pos: vec2f,      // position in reference pixels
    grain_fine: f32,
    grain_clump: f32,
    speckle: f32,
    speckle_slope: f32,    // how fast the speckle changes, per reference pixel
    edge_rough: f32,
    black: vec3f,
}

fn pixel_state(pos: vec2f, scn: Scene) -> Pixel {
    let vsize = u.view.zw - u.view.xy;
    let cover = pos_to_cover(pos.xy);
    let opx = u.resolution.x / vsize.x;   // output pixels per cover unit
    let px = opx / REFPX;                 // output pixels per reference pixel
    let fpx = 1.0 / px;
    // an edge ramps over one pixel where supersampling softens it further, and a little
    // more where the pixel shaded is the pixel shown
    let edge = px / max(1.0, 1.4 / u.supersampling);
    let fo = u.field_scale;
    let fv = sample_field(pos.xy);
    let fxp = sample_field(pos.xy + vec2f(fo, 0.0));
    let fxm = sample_field(pos.xy - vec2f(fo, 0.0));
    let fyp = sample_field(pos.xy + vec2f(0.0, fo));
    let fym = sample_field(pos.xy - vec2f(0.0, fo));
    let c = fv.r;
    let m = fv.g;
    let vflow = fv.ba;
    let rel = cover_to_plane(scn.cam, cover) - scn.centre;
    let s_down = rel.x / scn.radius;
    let rr = length(rel) / scn.radius;
    let gs = vec2f(fxp.r - fxm.r, fyp.r - fym.r) * (0.5 / fo) * px;
    let glen = max(length(gs), 1e-5);
    let gh = gs / glen;

    let gp = cover * REFPX;
    // grain riding with the liquid: fine speckle plus a coarser clumping
    let fine = flow_grain(gp, vflow, 1.2, fpx, 1.0);
    let clump = flow_grain(gp, vflow, 5.5, fpx, 9.0);
    let gfine = fine.x;
    let gclump = clump.x;
    let speck = 0.85 * gfine + 0.35 * gclump;
    let rough = 0.12 * gfine;

    let black = rgb255(14.0, 11.0, 15.0) * (1.0 + 0.25 * gfine);

    var pix: Pixel;
    pix.pos = pos;
    pix.cover = cover;
    pix.out_px_per_cover = opx;
    pix.out_px_per_ref = px;
    pix.ref_px_per_out = fpx;
    pix.edge = edge;
    pix.field_step = fo;
    pix.line = c;
    pix.flow_label = m;
    pix.line_grad_len = glen;
    pix.line_grad_dir = gh;
    pix.plane_rel = rel;
    pix.obstacle_dist = rr;
    pix.obstacle_down = s_down;
    pix.grain_pos = gp;
    pix.grain_fine = gfine;
    pix.grain_clump = gclump;
    pix.speckle = speck;
    pix.speckle_slope = length(0.85 * fine.yz + 0.35 * clump.yz);
    pix.edge_rough = rough;
    pix.black = black;
    return pix;
}

// Flat coloured stream.
fn stream_color(pix: Pixel) -> vec3f {
    let pos = pix.pos;
    let px = pix.out_px_per_ref;
    let c = pix.line;
    let glen = pix.line_grad_len;
    let rr = pix.obstacle_dist;
    let s_down = pix.obstacle_down;
    let speck = pix.speckle;
    let rough = pix.edge_rough;
    let black = pix.black;
    let red = rgb255(232.0, 38.0, 56.0);
    let pink = rgb255(240.0, 84.0, 140.0);
    let amber = rgb255(236.0, 166.0, 46.0);
    let orange = rgb255(240.0, 100.0, 40.0);
    var sc = mix(red, pink, smoothstep(4.5, 1.3, rr) * (1.0 - smoothstep(1.2, 2.4, s_down)));
    sc = mix(sc, orange, smoothstep(2.6, 3.6, s_down));
    sc = mix(sc, amber, smoothstep(3.4, 4.6, s_down));
    sc *= 1.0 + 0.035 * speck;
    // bands beside the stream stand proud of it and shade it on the side away from the light
    let ls = pos.xy + LIGHT * (2.2 * px);
    let lc = sample_field(ls).r;
    let shade_by = clamp(lc / glen * px + 0.5, 0.0, 1.0);
    sc *= 1.0 - 0.4 * shade_by;
    let cov = clamp((-c / glen + rough) * pix.edge + 0.5, 0.0, 1.0);
    return mix(black, sc, cov);
}

// Lilac stripe bands and the gaps between them.
fn band_color(pix: Pixel) -> vec3f {
    let px = pix.out_px_per_ref;
    let fpx = pix.ref_px_per_out;
    let c = pix.line;
    let m = pix.flow_label;
    let glen = pix.line_grad_len;
    let gh = pix.line_grad_dir;
    let gfine = pix.grain_fine;
    let gclump = pix.grain_clump;
    let speck = pix.speckle;
    let rough = pix.edge_rough;
    let black = pix.black;
    var col = black;
    let b = band_at(c, glen, gh, m, pix.edge, rough);
    if (b.coverage > 0.0) {
        // speckle where the grain beats the local density; its edges soften when minified,
        // and never cut sharper than a pixel can show
        let thr = (0.5 - b.density) * 2.6;
        let aa = max(0.3 + 0.6 * smoothstep(0.5, 2.0, 0.5 * fpx * u.supersampling), 0.7 * pix.speckle_slope / pix.edge);
        let dots = smoothstep(thr - aa, thr + aa, speck) * smoothstep(0.0, 0.08, b.density);
        var t = b.tone + 0.05 * gclump * smoothstep(0.85, 0.6, b.tone) + 0.03 * gfine - 0.44 * dots;
        col = mix(black, lilac(t), b.coverage);
    }
    // stripes too fine for the pixels settle to their average before they can beat
    let per_px = px / glen;
    col = mix(col, mix(black, lilac(0.5), DUTY), smoothstep(3.4, 2.0, per_px));
    return col;
}

// The ball as a sphere in camera space (unit = plane distance scale), and the light.
struct Ball {
    disc: vec2f,    // position on the ball's disc, in ball radii
    disc_r: f32,    // distance from the disc centre, in ball radii
    centre: vec3f,  // sphere centre in camera space
    radius: f32,    // sphere radius in camera space
}

fn ball_geometry(cover: vec2f, scn: Scene) -> Ball {
    let d2 = (cover - BALL_C) / BALL_R;
    let rd2 = length(d2);
    let rb0 = ray(BALL_C + vec2f(0.0, 0.9 * BALL_R));
    let zb = rb0.z * scn.cam.d / dot(scn.cam.n, rb0);
    let c3 = ray(BALL_C) * (zb / FOCAL);
    let r3 = BALL_R * zb / FOCAL;

    var ball: Ball;
    ball.disc = d2;
    ball.disc_r = rd2;
    ball.centre = c3;
    ball.radius = r3;
    return ball;
}

// The ball's shadow on the liquid (soft, wider further from the ball) and a little contact occlusion,
// as a factor on the colour.
fn ball_shadow(pix: Pixel, scn: Scene, ball: Ball) -> f32 {
    let cover = pix.cover;
    let rr = pix.obstacle_dist;
    let c3 = ball.centre;
    let r3 = ball.radius;
    let r0 = ray(cover);
    let oc = r0 * (scn.cam.d / dot(scn.cam.n, r0)) - c3;
    let lb = dot(oc, LIGHT3);
    let lh = sqrt(max(dot(oc, oc) - lb * lb, 0.0)) - r3;
    let pen = 0.16 * max(-lb, 0.0) + 0.05 * r3;
    // liquid drawn over the ball lies inside its footprint and stays lit
    let lit = max(mix(1.0, smoothstep(-pen, pen, lh), smoothstep(0.0, 0.3 * r3, -lb)),
                  smoothstep(1.05 * r3, 0.9 * r3, length(oc)));
    let contact = exp(-max(rr - 1.0, 0.0) * 12.0);
    return (1.0 - (0.24 + P(P_BALL_SHADOW)) * (1.0 - lit)) * (1.0 - 0.18 * contact);
}

// Far fade toward the upper right: the paint breaks up into a mottled spray. The mottling
// lives in the liquid's own coordinates (stripe periods), so it drifts with the flow.
fn spray_fade(col_in: vec3f, pix: Pixel) -> vec3f {
    let cover = pix.cover;
    let px = pix.out_px_per_ref;
    let c = pix.line;
    let m = pix.flow_label;
    let glen = pix.line_grad_len;
    let gfine = pix.grain_fine;
    let black = pix.black;
    var col = col_in;
    let fs = 0.45 * cover.x - 0.89 * cover.y - 0.22 * (cover.x - 0.6) * (cover.x - 0.6);
    let fd = 1.0 - smoothstep(-0.14, 0.4, fs);
    if (fd < 0.999 && c >= 0.0) {
        let cpp = px / glen;   // output px per stripe period
        let mq = vec2f(m, c);
        // mottle octaves fade out by the displayed pixels per cycle, as the grain does
        let dpp = cpp / u.supersampling;
        let vis1 = smoothstep(1.6, 2.5, dpp / 2.6);
        let vis2 = smoothstep(1.6, 2.5, dpp / 5.7);
        let ppp = 1.0 / cpp;   // stripe periods per shaded px
        let big = gradient_noise_spaced(mq * 0.13 + 2.0, 0.13 * ppp).x * 3.0 + gradient_noise_spaced(mq * 0.45 - 7.0, 0.45 * ppp).x * 1.5;
        let sp = (gradient_noise_spaced(mq * 2.6 + 11.0, 2.6 * ppp).x * vis1 + 0.7 * gradient_noise_spaced(mq * 5.7 - 3.0, 5.7 * ppp).x * vis2) * 3.4 + 0.5 * gfine;
        let fe = fd + (0.055 + P(P_SPRAY_MOTTLE)) * big;
        let painted = smoothstep(0.0, 0.62, fe);
        let thr = (0.5 - painted) * 2.4;
        var paint = mix(painted, smoothstep(thr - 0.75, thr + 0.75, sp), max(vis1, 0.35)) * smoothstep(0.0, 0.15, painted);
        paint = max(paint, smoothstep(0.6, 0.78, fe));
        // lines keep showing through the spray until deep in it; both turn violet
        let lum = dot(col, vec3f(0.3, 0.6, 0.1));
        let tint = 1.0 - smoothstep(0.2, 0.62, fe);
        let lines = mix(col, vec3f(0.8, 0.58, 1.12) * lum * 1.15, 0.75 * tint);
        let tone = rgb255(116.0, 86.0, 160.0) * clamp(0.72 + 0.16 * sp, 0.4, 1.15);
        let pc = mix(tone, lines, smoothstep(0.22, 0.6, fe));
        // a dim haze of the finest droplets between the blobs
        col = mix(mix(black, tone * 0.5, 0.35 * painted * (1.0 - painted)), pc, paint);
    }
    return col;
}

// The ball's surface point, turned with the ball, and the grain fixed to it.
struct BallSurface {
    height: f32,        // height of the surface point above the disc
    point: vec3f,       // surface point on the unit sphere
    turned: vec3f,      // the same point after the ball's turning
    tex_x: vec2f,       // surface coordinates in reference pixels, one per projection axis
    tex_y: vec2f,
    tex_z: vec2f,
    foot: f32,          // reference pixels per output pixel on the surface
    grain_fine: f32,
    grain_coarse: f32,
}

fn ball_surface(pix: Pixel, scn: Scene, ball: Ball) -> BallSurface {
    let fpx = pix.ref_px_per_out;
    let gp = pix.grain_pos;
    let d2 = ball.disc;
    let bz = sqrt(max(1.0 - dot(d2, d2), 0.0));
    // the ball turns slowly in the current, so its metallic paint (grain and flakes) is
    // fixed to the surface and travels with it
    let s0 = vec3f(d2, -bz);
    let ax = scn.cam.ev;
    let th = (0.08 + P(P_BALL_SPIN)) * u.time;
    let sr = s0 * cos(th) + cross(ax, s0) * sin(th) + ax * dot(ax, s0) * (1.0 - cos(th));
    let sw = sr * sr * sr * sr;
    let swn = sw / (sw.x + sw.y + sw.z);
    let sa = BALL_R * REFPX;                    // ref px per unit of surface
    let bfpx = fpx / max(bz, 0.3);
    let tx = sr.yz * sa;
    let ty = sr.zx * sa + 37.0;
    let tz = sr.xy * sa - 91.0;
    let wn = inverseSqrt(dot(swn, swn));
    // toward the rim the surface is squeezed past what the pixels can hold, so the grain
    // there is laid on the image instead
    let onsurf = smoothstep(0.12, 0.4, bz);
    // fine and coarse grain: laid on the image, and wrapped on the surface
    var flat = vec2f(0.0);
    var wrapped = vec2f(0.0);
    if (onsurf < 1.0) {
        flat = vec2f(grain(gp, 1.5, fpx), grain(gp, 4.0, fpx));
    }
    if (onsurf > 0.0) {
        wrapped = vec2f(swn.x * grain(tx, 1.5, bfpx) + swn.y * grain(ty, 1.5, bfpx) + swn.z * grain(tz, 1.5, bfpx),
                        swn.x * grain(tx, 4.0, bfpx) + swn.y * grain(ty, 4.0, bfpx) + swn.z * grain(tz, 4.0, bfpx)) * wn;
    }
    let gb = mix(flat.x, wrapped.x, onsurf);
    let gc = mix(flat.y, wrapped.y, onsurf);

    var surf: BallSurface;
    surf.height = bz;
    surf.point = s0;
    surf.turned = sr;
    surf.tex_x = tx;
    surf.tex_y = ty;
    surf.tex_z = tz;
    surf.foot = bfpx;
    surf.grain_fine = gb;
    surf.grain_coarse = gc;
    return surf;
}

// Flakes: tiny tilted mirrors on the surface. Each shows the surroundings for its own
// tilted normal, read off the painted ball, so they glint as the turning brings them round.
fn flake_glints(g_in: f32, ball: Ball, surf: BallSurface) -> f32 {
    let d2 = ball.disc;
    let bz = surf.height;
    let sr = surf.turned;
    let tx = surf.tex_x;
    let ty = surf.tex_y;
    let tz = surf.tex_z;
    let bfpx = surf.foot;
    var g = g_in;
    let asr = abs(sr);
    var ft = tz;
    if (asr.x > asr.y && asr.x > asr.z) { ft = tx; } else if (asr.y > asr.z) { ft = ty; }
    let fc = 2.6;
    let fcell = floor(ft / fc);
    let fh = hash22(fcell + 17.0);
    let fd2 = length(ft / fc - fcell - 0.5 - 0.3 * fh);
    let fsz = 0.22 * (0.7 + 0.3 * hash12(fcell + 5.0));
    let fon = (1.0 - smoothstep(fsz - 0.08, fsz + 0.08, fd2)) * step(0.35, hash12(fcell + 3.0))
        * (1.0 - smoothstep(0.6, 1.4, bfpx / fc));
    let tilt = hash22(fcell + 29.0) * (0.3 + P(P_FLAKE_TILT));
    let fn2 = d2 + tilt * bz;
    let glint = ball_lum(fn2 / max(length(fn2), 1.0) * 0.98);
    g = mix(g, max(glint, g * 0.8), fon * 0.65 * smoothstep(0.05, 0.25, bz));
    return g;
}

// Painted tone fitted to the cover, with the surface grain and the flakes.
fn ball_tone(ball: Ball, surf: BallSurface) -> f32 {
    let d2 = ball.disc;
    let gb = surf.grain_fine;
    let gc = surf.grain_coarse;
    var g = ball_lum(d2);
    g += (0.045 * gb + 0.02 * gc) * mix(1.0, 0.3, smoothstep(0.55, 0.9, g));

    g = flake_glints(g, ball, surf);

    g = clamp(g, 0.02, 0.97);
    return g;
}

fn chrome_color(g: f32) -> vec3f {
    let warm = smoothstep(0.08, 0.6, g);
    return vec3f(g * mix(0.99, 1.0, warm), g * mix(1.0, 0.985, smoothstep(0.6, 0.9, g)), g * mix(0.86, 1.03, warm));
}

// The liquid as the ball mirrors it, with the surface normal and ray origin it was found from.
struct Mirror {
    image: vec3f,   // colour of the mirrored liquid
    facing: f32,    // reflected ray against the plane normal; positive when it heads for the liquid
    normal: vec3f,  // surface normal, waviness included
    origin: vec3f,  // ray origin, held above the waterline
}

// The liquid mirrored in the chrome. The surface is not perfect: a slow waviness bends
// the image and its roughness blurs it, more toward the rim. Its derivatives are only off in
// quads straddling the caller's disc_r < 1.02 test, which lies beyond the ball's painted edge.
@diagnostic(off, derivative_uniformity)
fn liquid_reflection(pix: Pixel, scn: Scene, ball: Ball, surf: BallSurface) -> Mirror {
    let fo = pix.field_step;
    let d2 = ball.disc;
    let rd2 = ball.disc_r;
    let c3 = ball.centre;
    let r3 = ball.radius;
    let bz = surf.height;
    let s0 = surf.point;
    let wob = vec2f(gradient_noise(d2 * 3.1 + 4.0).x, gradient_noise(d2 * 3.1 - 9.0).x);
    let bn = normalize(vec3f(d2 + 0.05 * wob, -bz));
    let bp = c3 + s0 * r3;
    let rdir = reflect(normalize(bp), bn);
    let rden = dot(scn.cam.n, rdir);
    // the painted waterline sits lower than the plane cuts the sphere, so rays from below
    // the surface start just above it and pick up the liquid close by
    let bpl = bp - scn.cam.n * max(dot(scn.cam.n, bp) - scn.cam.d + 0.03 * r3, 0.0);
    let rt = (scn.cam.d - dot(scn.cam.n, bpl)) / rden;
    let rh = bpl + rdir * rt;
    let rcov = rh.xy / max(rh.z, 1e-3) * FOCAL + 0.5;
    let rpos = cover_to_pos(rcov);
    // the blur is a width on the cover, so the mirrored lines sharpen as the view closes in;
    // it never falls below the pixel's own footprint
    let blur = 0.19 * (4.0 + P(P_REFLECTION_BLUR) + 4.0 * pow(1.0 - bz, 2.0)) * pix.out_px_per_ref;
    let rfoot = (length(dpdx(rpos)) + length(dpdy(rpos))) * max(blur, pix.out_px_per_ref / pix.edge) + 1.5 * fo;
    var refl = vec3f(0.0);
    if (rt > 0.0 && rh.z > 0.0 && rd2 < 1.0) {
        var rc = 0.0;
        var rg = 0.05 * rfoot;
        if (all(rpos >= vec2f(fo)) && all(rpos < u.resolution - fo)) {
            rc = sample_field(rpos).r;
            rg = rfoot * (0.5 / fo) * length(vec2f(sample_field(rpos + vec2f(fo, 0.0)).r - sample_field(rpos - vec2f(fo, 0.0)).r,
                                                   sample_field(rpos + vec2f(0.0, fo)).r - sample_field(rpos - vec2f(0.0, fo)).r));
        } else {
            // off screen: undisturbed lines
            let q = vec2f(dot(rh, scn.cam.eu), dot(rh, scn.cam.ev)) - scn.centre;
            rc = abs(q.y * (1.0 - min(scn.radius * scn.radius / max(dot(q, q), 1e-4), 1.0))) - 0.8;
        }
        let rf = fract(rc);
        let rband = clamp(min(rf - (1.0 - DUTY), 1.0 - rf) / max(rg, 1e-3) + 0.5, 0.0, 1.0);
        let rline = mix(rband, DUTY, smoothstep(0.3, 0.8, rg));
        refl = mix(rgb255(232.0, 60.0, 96.0), rgb255(168.0, 137.0, 182.0) * rline, clamp(rc / max(rg, 1e-3) + 0.5, 0.0, 1.0));
    }

    var mir: Mirror;
    mir.image = refl;
    mir.facing = rden;
    mir.normal = bn;
    mir.origin = bpl;
    return mir;
}

// Light bounced off the liquid tints the side facing it: the colour of the liquid that
// way, blurred wide, so it shifts as the stream and the bands move past.
fn add_bounced_light(scol2_in: vec3f, g: f32, pix: Pixel, scn: Scene, mir: Mirror) -> vec3f {
    let fo = pix.field_step;
    let opx = pix.out_px_per_cover;
    let black = pix.black;
    let bn = mir.normal;
    let bpl = mir.origin;
    var scol2 = scol2_in;
    let nd = dot(scn.cam.n, bn);
    if (nd > 0.02) {
        let bh = bpl + bn * ((scn.cam.d - dot(scn.cam.n, bpl)) / nd);
        let bpos = cover_to_pos(bh.xy / max(bh.z, 1e-3) * FOCAL + 0.5);
        let spread = 0.3 * BALL_R * opx;
        let band_avg = mix(black, lilac(0.55), DUTY);
        var acc = vec3f(0.0);
        for (var k = 0; k < 5; k++) {
            let o = select(vec2f(f32(k & 1) * 2.0 - 1.0, f32((k >> 1u) & 1) * 2.0 - 1.0), vec2f(0.0), k == 4);
            let cc = sample_field(clamp(bpos + o * spread, vec2f(fo), u.resolution - fo)).r;
            acc += mix(rgb255(236.0, 56.0, 80.0), band_avg, smoothstep(-0.3, 0.3, cc));
        }
        scol2 += acc * (0.2 * (0.22 + P(P_BOUNCE_TINT))) * smoothstep(0.02, 0.5, nd) * (1.0 - 0.6 * g);
    }
    return scol2;
}

// Lays the ball over the liquid. Bands on the camera side lap over it, and along the
// waterline the liquid climbs the ball in a rolled lip that catches the light, with glints
// carried along it by the flow; the ball just above sits in its shade.
fn composite_ball(col_in: vec3f, scol2_in: vec3f, pix: Pixel, ball: Ball) -> vec3f {
    let px = pix.out_px_per_ref;
    let c = pix.line;
    let m = pix.flow_label;
    let glen = pix.line_grad_len;
    let gh = pix.line_grad_dir;
    let rel = pix.plane_rel;
    let d2 = ball.disc;
    let rd2 = ball.disc_r;
    var col = col_in;
    var scol2 = scol2_in;
    let liquid = clamp(c / glen * pix.edge + 0.5, 0.0, 1.0);    // 1 on bands and gaps, 0 on the stream
    let near = select(0.0, 1.0, rel.y < 0.0);
    let low = smoothstep(0.5, 0.56, d2.y - 0.25 * d2.x);     // far-side bands rejoin in front low on the right
    let front = liquid * max(near, low);

    let wl = c / glen;                                         // ref px from the waterline, + on the liquid
    let side = max(near, low) * smoothstep(1.0, 0.96, rd2);
    scol2 *= 1.0 - 0.45 * side * exp(min(wl, 0.0) / 3.5);
    var cov = clamp((1.0 - rd2) * BALL_R * REFPX * pix.edge + 0.5, 0.0, 1.0) * (1.0 - front);
    if (P(P_DEBUG_BALL_OUTLINE) > 0.5) { cov *= 0.35; }
    col = mix(col, scol2, cov);
    let facing = 0.3 + 0.7 * smoothstep(-0.5, 0.6, dot(-gh, LIGHT));
    let lip = side * (1.0 - cov) * facing;
    if (lip > 0.0) {
        let ppp = glen / px;   // stripe periods per shaded px
        let ride = smoothstep(-0.3, 0.5, gradient_noise_spaced(vec2f(m * 0.8, 3.3), 0.8 * ppp).x * 1.6 + 0.5 * gradient_noise_spaced(vec2f(m * 2.6, 9.1), 2.6 * ppp).x);
        let crest = exp(-pow((wl - 1.3) / 0.75, 2.0));
        let sheen = exp(-pow((wl - 2.8) / 1.6, 2.0));
        col = mix(col, rgb255(240.0, 228.0, 248.0), lip * crest * (0.25 + 0.75 * ride) * 0.9);
        col += rgb255(150.0, 120.0, 175.0) * lip * sheen * 0.18 * (0.5 + 0.5 * ride);
    }
    if (P(P_DEBUG_BALL_OUTLINE) > 0.5 && abs(rd2 - 1.0) < 0.012) { col = vec3f(0.0, 1.0, 0.0); }
    return col;
}

// The ball: painted tone fitted to the cover, with the liquid mirrored in it and lapping over it.
fn paint_ball(col_in: vec3f, pix: Pixel, scn: Scene, ball: Ball) -> vec3f {
    var col = col_in;
    if (ball.disc_r < 1.02) {
        let surf = ball_surface(pix, scn, ball);
        let bz = surf.height;
        let gc = surf.grain_coarse;
        let g = ball_tone(ball, surf);
        let scol = chrome_color(g);
        let mir = liquid_reflection(pix, scn, ball, surf);
        let refl = mir.image;
        let rden = mir.facing;
        // the lower half faces the liquid and mirrors its moving lines, strongest at grazing angles
        let rk = smoothstep(0.08, 0.6, rden) * (0.16 + P(P_BALL_REFLECTION) + 0.34 * pow(1.0 - bz, 2.0)) * (1.0 + 0.15 * gc);
        var scol2 = mix(scol, refl * 1.1 + scol * 0.25, rk);
        scol2 = add_bounced_light(scol2, g, pix, scn, mir);
        col = composite_ball(col, scol2, pix, ball);
    }
    return col;
}

// Glare round the two highlights, breathing a little as if light came through moving water.
fn glare(col_in: vec3f, cover: vec2f) -> vec3f {
    let fl1 = 1.0 + 0.1 * gradient_noise(vec2f(u.time * 0.9, 1.7)).x * 2.0;
    let h1 = length(cover - (BALL_C + BALL_R * vec2f(-0.43, -0.45))) / BALL_R;
    let h2 = length(cover - (BALL_C + BALL_R * vec2f(0.045, -0.57))) / BALL_R;
    let glow = (0.3 * exp(-pow(h1 / 0.42, 2.0)) + 0.07 * exp(-h1 / 0.45)
              + 0.22 * exp(-pow(h2 / 0.2, 2.0)) + 0.04 * exp(-h2 / 0.3)) * fl1 * (1.0 + P(P_GLARE_GAIN));
    return 1.0 - (1.0 - col_in) * (1.0 - glow * rgb255(255.0, 236.0, 250.0));
}

@fragment
fn fs_main(@builtin(position) pos: vec4f) -> @location(0) vec4f {
    let scn = scene();
    let pix = pixel_state(pos.xy, scn);
    let ball = ball_geometry(pix.cover, scn);

    var col: vec3f;
    if (pix.line < 0.0) {
        col = stream_color(pix);
    } else {
        col = band_color(pix);
    }
    col *= ball_shadow(pix, scn, ball);
    col = spray_fade(col, pix);
    col = paint_ball(col, pix, scn, ball);
    col = glare(col, pix.cover);
    return vec4f(col, 1.0);
}
